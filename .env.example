# ============================================================
# KASHISH AI — Environment Variables (OPTIONAL integrations)
# Copy this file to `.env` and fill in values you want to use.
# NEVER commit `.env` or place private tokens in client code.
# Anything prefixed with VITE_ is exposed to the browser bundle,
# so ONLY put non-secret, public config here.
# ============================================================

# --- GitHub (System Status dashboard) ---
# Public username only. No token needed for public read-only data.
VITE_GITHUB_USERNAME=kashishhchopra

# --- Portfolio Assistant: Claude API (OPTIONAL but recommended) ---
# The assistant answers in depth about the projects, architectures and
# engineering decisions when this key is set. Without it, it silently falls
# back to a deterministic local responder — it still answers, just not as
# fluently. Set this in the Vercel project's environment variables.
#
# NOT prefixed with VITE_ on purpose: it is read only by the server-side
# function at api/assistant.ts, so the key never enters the browser bundle.
# Never put a provider key in a VITE_ variable.
ANTHROPIC_API_KEY=

# Point the chat at a proxy hosted somewhere other than this project's
# /api/assistant. Leave empty to use the bundled endpoint.
VITE_ASSISTANT_API_URL=

# --- Canonical site URL (OPTIONAL) ---
# Pins <link rel="canonical"> and og:url. Without it they are derived from
# the live origin at runtime. Also pass SITE_URL when building to generate
# sitemap.xml:  SITE_URL=https://your-domain.com npm run build
VITE_SITE_URL=

# --- Contact form service (OPTIONAL) ---
# e.g. a Formspree / Getform / Web3Forms endpoint. If empty, the
# contact form falls back to a mailto: link (no false "sent" claims).
VITE_CONTACT_FORM_ENDPOINT=
